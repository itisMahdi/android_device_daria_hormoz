cc_binary {
    name: "vendor.lineage.touch-service.hormoz",
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.touch-service.hormoz.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.hormoz.xml"],
    srcs: [
        "HighTouchPollingRate.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.lineage.touch-V1-ndk",
    ],
    vendor: true,
}
