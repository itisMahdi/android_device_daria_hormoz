<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds.  Do not translate.

     NOTE: The naming convention is "config_camelCaseValue". Some legacy
     entries do not follow the convention, but all new entries should. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Whether to show Smooth Display feature in Settings Options -->
    <bool name="config_show_smooth_display">true</bool> 

    <!-- Display settings screen, Color mode options. Must be the same length and order as
         config_color_mode_options_values below. Only the values that also appear in
         frameworks/base/core/res/res/values/config.xml's config_availableColorModes are shown. -->
    <string-array name="config_color_mode_options_strings" translatable="false">
        <item>Alive</item>
        <item>Standard</item>
    </string-array>

     <integer-array name="config_color_mode_options_values" translatable="false">
        <item>1</item>
        <item>0</item>
    </integer-array>

    <!-- Show battery cycle count -->
    <bool name="config_show_battery_cycle_count" translatable="false">true</bool>
    <bool name="config_show_face_unlock_attention_switch">false</bool>
    <bool name="config_show_wifi_hotspot_speed">false</bool>
    <integer name="config_maximumScreenOffTimeout">600000</integer>
    <integer name="config_udfpsEnrollProgressBar">100</integer>
    <integer name="config_vibration_supported_intensity_levels">3</integer>
</resources>
